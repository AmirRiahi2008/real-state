NODE_ENV=development
PORT=4000
HOST=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://estate:replace-with-a-random-local-password@localhost:5433/estate
REDIS_PASSWORD=replace-with-a-random-local-password
REDIS_PORT=6380
REDIS_URL=redis://:replace-with-a-random-local-password@localhost:6380
RATE_LIMIT_NAMESPACE=estate:rate
JWT_SECRET=replace-with-at-least-64-random-characters-generated-by-setup-local
JWT_ISSUER=uae-real-estate-api
JWT_AUDIENCE=uae-real-estate-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Real Estate <no-reply@example.test>
SMTP_USER=
SMTP_PASS=
SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Administrator
