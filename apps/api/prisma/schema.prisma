generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEAM_MEMBER
  CUSTOMER
  AGENT
  ADMIN
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum Emirate {
  DUBAI
  ABU_DHABI
  SHARJAH
  AJMAN
  RAS_AL_KHAIMAH
  FUJAIRAH
  UMM_AL_QUWAIN
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  DUPLEX
  STUDIO
  OFFICE
  RETAIL
  LAND
  WAREHOUSE
}

enum ListingPurpose {
  SALE
  RENT
}

enum CompletionStatus {
  READY
  OFF_PLAN
}

enum Availability {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum RentalPeriod {
  YEAR
  MONTH
  WEEK
  DAY
}

enum LeadType {
  ENQUIRY
  VIEWING
  VALUATION
  MORTGAGE
  PROJECT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum ContentType {
  NEWS
  ARTICLE
  AREA_GUIDE
  MARKET_REPORT
  BUYER_GUIDE
  SERVICE
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(254)
  passwordHash    String
  firstName       String         @db.VarChar(80)
  lastName        String         @db.VarChar(80)
  role            Role           @default(CUSTOMER)
  isActive        Boolean        @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        AuthSession[]
  tokens          OneTimeToken[]
  agentProfile    AgentProfile?
  teamProfile     TeamProfile?
  listings        Listing[]
  media           Media[]
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  assignedLeads   Lead[]         @relation("AssignedLeads")
  auditLogs       AuditLog[]
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model OneTimeToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model EmailOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  to            String    @db.VarChar(254)
  subject       String    @db.VarChar(200)
  text          String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?
  sentAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([sentAt, nextAttemptAt])
}

model Area {
  id            String         @id @default(uuid()) @db.Uuid
  slug          String         @unique @db.VarChar(120)
  nameEn        String         @db.VarChar(160)
  nameAr        String         @db.VarChar(160)
  descriptionEn String         @default("") @db.Text
  descriptionAr String         @default("") @db.Text
  emirate       Emirate
  latitude      Decimal?       @db.Decimal(9, 6)
  longitude     Decimal?       @db.Decimal(9, 6)
  parentId      String?        @db.Uuid
  parent        Area?          @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children      Area[]         @relation("AreaHierarchy")
  isActive      Boolean        @default(true)
  listings      Listing[]
  projects      Project[]
  agents        AgentProfile[]
  articles      Article[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([emirate, isActive])
}

model Developer {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique @db.VarChar(120)
  nameEn        String    @db.VarChar(160)
  nameAr        String    @db.VarChar(160)
  descriptionEn String    @default("") @db.Text
  descriptionAr String    @default("") @db.Text
  website       String?   @db.VarChar(500)
  isActive      Boolean   @default(true)
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Amenity {
  id       String           @id @default(uuid()) @db.Uuid
  slug     String           @unique @db.VarChar(80)
  nameEn   String           @db.VarChar(120)
  nameAr   String           @db.VarChar(120)
  listings ListingAmenity[]
  projects ProjectAmenity[]
}

model AgentProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  slug         String   @unique @db.VarChar(120)
  displayName  String   @db.VarChar(160)
  bioEn        String   @default("") @db.Text
  bioAr        String   @default("") @db.Text
  publicEmail  String?  @db.VarChar(254)
  phone        String?  @db.VarChar(24)
  whatsapp     String?  @db.VarChar(24)
  reraNumber   String?  @db.VarChar(40)
  languages    String[]
  isPublic     Boolean  @default(false)
  areaId       String?  @db.Uuid
  photoMediaId String?  @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area         Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  photo        Media?   @relation("AgentPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Listing {
  id                String             @id @default(uuid()) @db.Uuid
  reference         String             @unique @db.VarChar(40)
  slug              String             @unique @db.VarChar(160)
  titleEn           String             @db.VarChar(200)
  titleAr           String             @db.VarChar(200)
  descriptionEn     String             @db.Text
  descriptionAr     String             @db.Text
  descriptionRichEn Json?
  descriptionRichAr Json?
  purpose           ListingPurpose
  propertyType      PropertyType
  completion        CompletionStatus
  availability      Availability       @default(AVAILABLE)
  furnishing        Furnishing         @default(UNFURNISHED)
  status            PublicationStatus  @default(DRAFT)
  priceAed          Decimal?           @db.Decimal(16, 2)
  priceOnRequest    Boolean            @default(false)
  previousPriceAed  Decimal?           @db.Decimal(16, 2)
  rentalPeriod      RentalPeriod?
  areaSqm           Decimal            @db.Decimal(12, 2)
  plotAreaSqm       Decimal?           @db.Decimal(12, 2)
  bedrooms          Int
  bathrooms         Int
  parking           Int                @default(0)
  addressEn         String             @db.VarChar(300)
  addressAr         String             @db.VarChar(300)
  latitude          Decimal?           @db.Decimal(9, 6)
  longitude         Decimal?           @db.Decimal(9, 6)
  vacantOn          DateTime?          @db.Date
  handoverDate      DateTime?          @db.Date
  isExclusive       Boolean            @default(false)
  permitNumber      String?            @db.VarChar(64)
  permitUrl         String?            @db.VarChar(600)
  areaId            String             @db.Uuid
  agentId           String             @db.Uuid
  projectId         String?            @db.Uuid
  area              Area               @relation(fields: [areaId], references: [id], onDelete: Restrict)
  agent             User               @relation(fields: [agentId], references: [id], onDelete: Restrict)
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  media             ListingMedia[]
  amenities         ListingAmenity[]
  favorites         Favorite[]
  leads             Lead[]
  publishedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  version           Int                @default(1)
  richMedia         ListingRichMedia[]

  @@index([status, purpose, createdAt(sort: Desc)])
  @@index([areaId, status, priceAed])
  @@index([agentId, status])
  @@index([propertyType, bedrooms])
  @@index([latitude, longitude])
}

model Project {
  id                String             @id @default(uuid()) @db.Uuid
  slug              String             @unique @db.VarChar(160)
  nameEn            String             @db.VarChar(200)
  nameAr            String             @db.VarChar(200)
  descriptionEn     String             @db.Text
  descriptionAr     String             @db.Text
  descriptionRichEn Json?
  descriptionRichAr Json?
  status            PublicationStatus  @default(DRAFT)
  startingPriceAed  Decimal?           @db.Decimal(16, 2)
  priceOnRequest    Boolean            @default(false)
  handoverDate      DateTime?          @db.Date
  minBedrooms       Int
  maxBedrooms       Int
  propertyTypes     PropertyType[]
  paymentPlan       Json               @default("[]")
  floorPlans        Json               @default("[]")
  latitude          Decimal?           @db.Decimal(9, 6)
  longitude         Decimal?           @db.Decimal(9, 6)
  developerId       String             @db.Uuid
  areaId            String             @db.Uuid
  developer         Developer          @relation(fields: [developerId], references: [id], onDelete: Restrict)
  area              Area               @relation(fields: [areaId], references: [id], onDelete: Restrict)
  listings          Listing[]
  media             ProjectMedia[]
  amenities         ProjectAmenity[]
  leads             Lead[]
  publishedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  version           Int                @default(1)
  richMedia         ProjectRichMedia[]

  @@index([status, createdAt(sort: Desc)])
  @@index([areaId, developerId])
}

model Media {
  id           String             @id @default(uuid()) @db.Uuid
  ownerId      String             @db.Uuid
  storageKey   String             @unique @db.VarChar(100)
  mimeType     String             @db.VarChar(40)
  size         Int
  width        Int
  height       Int
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  listings     ListingMedia[]
  projects     ProjectMedia[]
  agentPhotos  AgentProfile[]     @relation("AgentPhoto")
  teamPhotos   TeamProfile[]      @relation("TeamPhoto")
  articles     Article[]
  createdAt    DateTime           @default(now())
  richListings ListingRichMedia[]
  richProjects ProjectRichMedia[]
  richArticles ArticleRichMedia[]
}

model ListingMedia {
  listingId String  @db.Uuid
  mediaId   String  @db.Uuid
  position  Int
  altEn     String  @default("") @db.VarChar(200)
  altAr     String  @default("") @db.VarChar(200)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([listingId, mediaId])
  @@index([listingId, position])
}

model ProjectMedia {
  projectId String  @db.Uuid
  mediaId   String  @db.Uuid
  position  Int
  altEn     String  @default("") @db.VarChar(200)
  altAr     String  @default("") @db.VarChar(200)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([projectId, mediaId])
  @@index([projectId, position])
}

model ListingAmenity {
  listingId String  @db.Uuid
  amenityId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([listingId, amenityId])
}

model ProjectAmenity {
  projectId String  @db.Uuid
  amenityId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([projectId, amenityId])
}

model Favorite {
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model SavedSearch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.VarChar(100)
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Lead {
  id            String     @id @default(uuid()) @db.Uuid
  type          LeadType
  status        LeadStatus @default(NEW)
  name          String     @db.VarChar(160)
  email         String     @db.VarChar(254)
  phone         String     @db.VarChar(24)
  message       String     @db.VarChar(3000)
  preferredAt   DateTime?
  consent       Boolean
  listingId     String?    @db.Uuid
  projectId     String?    @db.Uuid
  assignedToId  String?    @db.Uuid
  internalNotes String     @default("") @db.VarChar(5000)
  listing       Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo    User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([assignedToId, status, createdAt])
  @@index([createdAt])
}

model Article {
  id           String             @id @default(uuid()) @db.Uuid
  slug         String             @unique @db.VarChar(160)
  type         ContentType
  titleEn      String             @db.VarChar(200)
  titleAr      String             @db.VarChar(200)
  excerptEn    String             @db.VarChar(600)
  excerptAr    String             @db.VarChar(600)
  bodyEn       String             @db.Text
  bodyAr       String             @db.Text
  bodyRichEn   Json?
  bodyRichAr   Json?
  status       PublicationStatus  @default(DRAFT)
  areaId       String?            @db.Uuid
  coverMediaId String?            @db.Uuid
  area         Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  cover        Media?             @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  version      Int                @default(1)
  richMedia    ArticleRichMedia[]

  @@index([status, type, publishedAt(sort: Desc)])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(100)
  requestId  String?  @db.VarChar(64)
  metadata   Json     @default("{}")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

enum TeamMessageSender {
  VISITOR
  STAFF
}

model TeamProfile {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @unique @db.Uuid
  slug          String             @unique @db.VarChar(120)
  displayName   String             @db.VarChar(160)
  titleEn       String             @db.VarChar(80)
  titleAr       String             @db.VarChar(80)
  bioEn         String             @default("") @db.VarChar(2000)
  bioAr         String             @default("") @db.VarChar(2000)
  avatarMediaId String?            @db.Uuid
  isPublic      Boolean            @default(true)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar        Media?             @relation("TeamPhoto", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  conversations TeamConversation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model TeamConversation {
  id                    String        @id @default(uuid()) @db.Uuid
  memberId              String        @db.Uuid
  visitorName           String        @db.VarChar(160)
  visitorEmail          String        @db.VarChar(254)
  visitorTokenHash      String        @unique @db.VarChar(64)
  visitorTokenExpiresAt DateTime
  consentAt             DateTime      @default(now())
  member                TeamProfile   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  messages              TeamMessage[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([memberId, updatedAt(sort: Desc), id])
  @@index([visitorTokenExpiresAt])
}

model TeamMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  sender         TeamMessageSender
  body           String            @db.VarChar(3000)
  conversation   TeamConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt(sort: Desc), id])
}

model SiteContent {
  key       String   @id @db.VarChar(40)
  values    Json     @default("{}")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ListingRichMedia {
  listingId String  @db.Uuid
  mediaId   String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([listingId, mediaId])
  @@index([mediaId])
}

model ProjectRichMedia {
  projectId String  @db.Uuid
  mediaId   String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([projectId, mediaId])
  @@index([mediaId])
}

model ArticleRichMedia {
  articleId String  @db.Uuid
  mediaId   String  @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([articleId, mediaId])
  @@index([mediaId])
}
