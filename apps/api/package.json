{
  "name": "@real-estate/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma --no-error-on-unmatched-pattern --max-warnings=0",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --config jest.config.cjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/e2e.test.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "admin:create": "node --import tsx src/scripts/create-admin.ts",
    "openapi:export": "npm run build && node dist/scripts/export-openapi.js",
    "team:provision": "node --import tsx src/scripts/provision-team.ts",
    "admin:promote-local": "node --import tsx src/scripts/promote-local-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "@oriva/rich-content": "0.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
